{
  "name": "opsec-mirror",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "concurrently -k -n frontend,backend \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:frontend": "pnpm --filter @opsec-mirror/frontend dev",
    "dev:backend": "python -m uvicorn backend.ai.voice_server:app --reload --port 8000",
    "build": "pnpm --filter @opsec-mirror/frontend build",
    "lint": "pnpm --filter @opsec-mirror/frontend lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
