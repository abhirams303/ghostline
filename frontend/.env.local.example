# Frontend runtime env
# Copy this file to frontend/.env.local before local development.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/dark-v11

# Server-only: used by frontend/src/app/api/pipecat/start/route.ts.
# Use a Pipecat Cloud public API key, not a pcc_pat_ personal access token.
PIPECAT_CLOUD_API_KEY=
PIPECAT_AGENT_NAME=gradient-bang-bot
PIPECAT_CLOUD_API_BASE=https://api.pipecat.daily.co/v1/public
