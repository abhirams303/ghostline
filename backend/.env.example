# Backend runtime env
# Copy this file to backend/.env before local development.

OPSEC_MIRROR_ENV=development
OPSEC_MIRROR_CORS_ORIGINS=["http://localhost:3000"]
OPSEC_MIRROR_CACHE_TTL_SECONDS=900
OPSEC_MIRROR_USE_DEMO_CACHE=false

# Collector switches
OPSEC_MIRROR_STRAVA_ENABLED=false
OPSEC_MIRROR_ADSB_ENABLED=true
OPSEC_MIRROR_SATELLITE_ENABLED=true
OPSEC_MIRROR_EXA_ENABLED=true

# ADS-B Exchange
ADSBEXCHANGE_API_KEY=
OPSEC_MIRROR_ADSB_BASE_URL=https://adsbexchange.com
OPSEC_MIRROR_ADSB_TIMEOUT_SECONDS=10
OPSEC_MIRROR_ADSB_MAX_AIRCRAFT=25
OPSEC_MIRROR_ADSB_LOW_ALTITUDE_THRESHOLD_FT=5000

# Synthesis provider
OPENAI_API_KEY=
OPSEC_MIRROR_OPENAI_MODEL=gpt-5.4-mini

# Pipecat voice agent providers
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
DEEPGRAM_MODEL=nova-3-general
OPENAI_LLM_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.4
OPENAI_MAX_TOKENS=180
CARTESIA_MODEL=sonic-3
CARTESIA_VOICE_ID=ec1e269e-9ca0-402f-8a18-58e0e022355a
GHOSTLINE_VOICE_SERVER_URL=http://localhost:8000

# Collector provider keys
EXA_API_KEY=
OPSEC_MIRROR_EXA_BASE_URL=https://api.exa.ai
OPSEC_MIRROR_EXA_NUM_RESULTS=3
OPSEC_MIRROR_EXA_LOOKBACK_DAYS=30
OPSEC_MIRROR_EXA_HIGHLIGHTS_MAX_CHARACTERS=600
MAPBOX_TOKEN=

# OpenStreetMap Nominatim geocoding
# Public service is intended for local/light use. Keep an identifying User-Agent.
OPSEC_MIRROR_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OPSEC_MIRROR_NOMINATIM_TIMEOUT_SECONDS=5
OPSEC_MIRROR_NOMINATIM_USER_AGENT=OPSEC-Mirror/0.1
OPSEC_MIRROR_NOMINATIM_EMAIL=

# Local persistence
OPSEC_MIRROR_DATABASE_PATH=data/runtime/opsec_mirror.sqlite3

# Strava global heatmap cookies
# Get these from https://www.strava.com/maps/global-heatmap
# DevTools -> Application/Storage -> Cookies -> content-a.strava.com
STRAVA_CF_KEY_PAIR_ID=
STRAVA_CF_POLICY=
STRAVA_CF_SIGNATURE=
# Optional, but Strava's edge may require these when copied from a working browser tile request.
STRAVA_IDCF=
STRAVA_CF_EXPIRES=
